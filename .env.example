# Telehealth Guard Agent — environment configuration example
# Copy this file to .env and fill in your keys.
# The app works in rules-only mode if neither key is set.

# Groq API key (primary LLM provider)
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model name (default shown below)
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API key (fallback LLM provider)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model name (default shown below)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
